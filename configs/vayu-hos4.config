# HOS4 port fragment for POCO X3 Pro (vayu) on ducky's 4.19 sm8150 tree.
# Merged on top of vendor/sm8150-perf_defconfig + sm8150-common.config + vayu.config.

# HyperOS 4 dynamic partitions (vendor/odm are erofs in the 4.19 vendor)
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# Android userspace requirements
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_COMPAT=y
CONFIG_PSI=y

# Loadable vendor modules (audio, wlan, rmnet, exfat, mpq)
CONFIG_MODULES=y
CONFIG_MODULE_SIG=n

# Keep the image lean and fast to build
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_NONE=y
